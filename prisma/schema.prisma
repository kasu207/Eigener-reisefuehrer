generator client {
  provider = "prisma-client-js"
  // "native" für lokale Entwicklung, Debian-Target für das Docker-Image
  // (node:22-bookworm-slim => OpenSSL 3)
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  // Für pg_trgm/unaccent (Volltext- & Ähnlichkeitssuche in der Wissensdatenbank,
  // beides Standard-Postgres-Contrib-Module, kein externer Dienst)
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // pg_trgm: Ähnlichkeitssuche (Dedup, Namens-Fuzzy-Matching).
  // unaccent: Akzente ignorieren (Café == Cafe) für Volltext- & Ähnlichkeitssuche.
  // Beide sind Teil von "postgresql-contrib" und stecken in jedem Standard-
  // Postgres-Image (kein zusätzlicher Dienst, keine externe API).
  extensions = [pgTrgm(map: "pg_trgm"), unaccent]
}

enum PlaceType {
  village
  sight
  viewpoint
  beach
  restaurant
  bar
  hotel
  event
  practical
  /// Ausflugsziel in der weiteren Umgebung, das einen ganzen Tag füllt
  /// (Nachbarort, Bergbahn, Talwanderung). Bewusst ein eigener Typ und nicht
  /// "sight": Ein Tagesausflug wird anders geplant als ein Halt um die Ecke.
  daytrip
}

enum InfoFormat {
  prose
  table
  timeline
}

enum Access {
  car
  public
  foot
}

enum Difficulty {
  easy
  medium
  hard
}

enum ContentStatus {
  draft
  verified
}

enum RequestStatus {
  pending
  generating
  ready
  failed
}

enum SourceType {
  reddit
  blog
  instagram
  portal
  youtube
  own
}

enum DocumentKind {
  book
  guidebook
  blog
  article
}

enum DocumentStatus {
  uploaded
  processing
  analyzed
  failed
}

/// Moderations-Workflow für die community-gespeiste Wissensdatenbank:
/// Nutzer-Einreichungen starten als `pending` und werden erst nach
/// redaktioneller Freigabe analysiert. Die KI-Analyse prüft zusätzlich
/// auf unzulässige Inhalte (FSK 18, extremistisch, strafrechtlich relevant)
/// und lehnt solche Quellen automatisch ab.
enum ModerationStatus {
  pending
  approved
  rejected
}

/// Wissensquellen: hochgeladene Bücher/Reiseführer (PDF/Text) oder verlinkte
/// Blogs – von der Redaktion ODER von Nutzern eingereicht. Die KI liest sie
/// ein und legt paraphrasierte, getaggte Notizen (KnowledgeChunk) an –
/// niemals wörtliche Übernahmen. So wächst eine kuratierte, von vielen
/// Nutzern gespeiste Wissensdatenbank.
model KnowledgeDocument {
  id               String           @id @default(cuid())
  regionId         String           @map("region_id")
  region           Region           @relation(fields: [regionId], references: [id], onDelete: Cascade)
  kind             DocumentKind
  title            String
  url              String? // bei Blogs/Artikeln
  fileName         String?          @map("file_name")
  mimeType         String?          @map("mime_type")
  fileData         Bytes?           @map("file_data")
  status           DocumentStatus   @default(uploaded)
  moderationStatus ModerationStatus @default(approved) @map("moderation_status")
  moderationNote   String           @default("") @map("moderation_note")
  submitterName    String           @default("") @map("submitter_name")
  submittedByUser  Boolean          @default(false) @map("submitted_by_user")
  error            String?
  createdAt        DateTime         @default(now()) @map("created_at")
  chunks           KnowledgeChunk[]

  @@map("knowledge_documents")
}

/// Eine aufbereitete Erkenntnis aus einer Wissensquelle: eigene Formulierung,
/// getaggt mit Interessen (Fragebogen-Matching) und an konkrete Orte gebunden.
/// Retrieval läuft über Postgres-Bordmittel: Volltextsuche (to_tsvector,
/// zur Laufzeit berechnet) + Trigram-Ähnlichkeit (pg_trgm) für Dedup –
/// kein externer Dienst, keine Embeddings.
model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String            @map("document_id")
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String
  content    String
  interests  String[] // Keys aus dem Fragebogen (wandern, kulinarik, ...)
  /// Aufgelöste Verweise auf `places.id` (exakte Ortszuordnung).
  placeIds   String[]          @map("place_ids")
  /// NICHT auflösbare Ortsnamen – Kandidaten für neue Orts-Einträge
  /// (Altbestand vor der Umstellung enthält hier alle genannten Namen).
  placeNames String[]          @map("place_names")
  createdAt  DateTime          @default(now()) @map("created_at")

  @@map("knowledge_chunks")
}

model Region {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  country     String
  centerLat   Float               @map("center_lat")
  centerLng   Float               @map("center_lng")
  description String              @default("")
  places      Place[]
  hikes       Hike[]
  infos       RegionInfo[]
  documents   KnowledgeDocument[]
  mapSpots    MapSpot[]

  @@map("regions")
}

enum SpotCategory {
  photo
  food
  viewpoint
  hidden_gem
  beach
  other
}

/// Zusätzliche, leichtgewichtige Karten-Pins – z. B. auf Instagram entdeckte
/// Foto-Spots und Geheimtipps. Bewusst getrennt von den kuratierten `places`:
/// nur Standort + redaktionelle Notiz + Quell-Link (Instagram-Profil/Post).
/// Es wird KEIN Instagram-Inhalt eingebettet oder kopiert (Rechtslage, 5.3).
model MapSpot {
  id             String        @id @default(cuid())
  regionId       String        @map("region_id")
  region         Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name           String
  category       SpotCategory  @default(photo)
  lat            Float
  lng            Float
  locality       String        @default("")
  note           String        @default("")
  sourceUrl      String        @default("") @map("source_url")
  sourceLabel    String        @default("") @map("source_label")
  status         ContentStatus @default(draft)
  createdAt      DateTime      @default(now()) @map("created_at")

  @@map("map_spots")
}

/// Standard-Infos zur Region wie in klassischen Reiseführern:
/// Währung, Geschichte, kleiner Sprachführer, Trinkwasser usw.
/// Werden redaktionell gepflegt und in jedem Guide als Kapitel
/// "Gut zu wissen" ausgespielt.
model RegionInfo {
  id        String     @id @default(cuid())
  regionId  String     @map("region_id")
  region    Region     @relation(fields: [regionId], references: [id], onDelete: Cascade)
  title     String
  content   String
  /// prose: Fließtext · table: Zeilen "a | b" (Sprachführer) ·
  /// timeline: Zeilen "Jahr | Ereignis | optionaler Side-Fact" (Geschichte)
  format    InfoFormat @default(prose)
  sortOrder Int        @default(0) @map("sort_order")

  @@map("region_infos")
}

model Place {
  id             String        @id @default(cuid())
  regionId       String        @map("region_id")
  region         Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  type           PlaceType
  name           String
  /// Ort/Stadt, zu der dieser Eintrag gehört (z. B. "Varenna").
  /// Leer = regionsweit (z. B. übergreifende Verkehrs-Hinweise).
  locality       String        @default("")
  lat            Float
  lng            Float
  address        String        @default("")
  tags           String[]
  priceLevel     Int?          @map("price_level") // 1-4
  openingNotes   String        @default("") @map("opening_notes")
  childFriendly  Boolean       @default(true) @map("child_friendly")
  access         Access        @default(car)
  dietaryOptions String[]      @map("dietary_options") // vegetarian | vegan | glutenfree
  editorNotes    String        @default("") @map("editor_notes")
  qualityScore   Int           @default(3) @map("quality_score") // 1-5
  /// Pflicht-Highlight: erscheint immer im Guide, unabhängig vom Matching.
  mustSee        Boolean       @default(false) @map("must_see")
  status         ContentStatus @default(draft)
  lastVerifiedAt DateTime?     @map("last_verified_at")
  /// Vom Nutzer im eigenen Guide ergänzt: eigener Tipp oder übernommener
  /// Recherche-Vorschlag. Solche Orte sind NUR für diesen einen Guide
  /// sichtbar. Ohne diese Trennung landet der private Tipp von Kundin A im
  /// Reiseführer von Kunde B – und das Versprechen „redaktionell geprüft"
  /// wäre nicht mehr haltbar. Redaktion sieht sie im Admin und kann sie
  /// durch Leeren des Feldes in den allgemeinen Bestand übernehmen.
  addedByRequestId String?     @map("added_by_request_id")
  images         Image[]
  sources        Source[]

  @@index([regionId, addedByRequestId])
  @@map("places")
}

model Hike {
  id               String        @id @default(cuid())
  regionId         String        @map("region_id")
  region           Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name             String
  locality         String        @default("")
  startLat         Float         @map("start_lat")
  startLng         Float         @map("start_lng")
  startDescription String        @default("") @map("start_description")
  distanceKm       Float         @map("distance_km")
  durationMin      Int           @map("duration_min")
  elevationGainM   Int           @map("elevation_gain_m")
  difficulty       Difficulty
  childFriendly    Boolean       @default(false) @map("child_friendly")
  gpxFile          String?       @map("gpx_file")
  /// Link zum Aufrufen der Tour (z. B. Komoot/Outdooractive); wird im
  /// Guide mit QR-Code abgebildet.
  externalUrl      String?       @map("external_url")
  descriptionNotes String        @default("") @map("description_notes")
  tags             String[]
  status           ContentStatus @default(draft)
  lastVerifiedAt   DateTime?     @map("last_verified_at")
  images           Image[]
  sources          Source[]

  @@map("hikes")
}

model Image {
  id        String  @id @default(cuid())
  placeId   String? @map("place_id")
  place     Place?  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  hikeId    String? @map("hike_id")
  hike      Hike?   @relation(fields: [hikeId], references: [id], onDelete: Cascade)
  fileUrl   String  @map("file_url")
  license   String
  author    String
  sourceUrl String  @map("source_url")

  @@map("images")
}

/// Von der Redaktion ausdrücklich als "kein Duplikat" markiertes Ortspaar.
/// Ohne das würde die Dubletten-Ansicht dieselben Fehltreffer (z. B. zwei
/// echte "Bar Centrale" in Nachbardörfern) bei jedem Aufruf erneut zeigen.
/// Bewusst ohne Fremdschlüssel: Ein gelöschter Ort macht den Eintrag
/// wirkungslos, nicht kaputt; die Ansicht ignoriert unbekannte IDs.
model DuplicateDismissal {
  id        String   @id @default(cuid())
  /// Kleinere der beiden IDs zuerst – macht das Paar richtungsunabhängig.
  aId       String   @map("a_id")
  bId       String   @map("b_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([aId, bId])
  @@map("duplicate_dismissals")
}

model Source {
  id         String     @id @default(cuid())
  placeId    String?    @map("place_id")
  place      Place?     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  hikeId     String?    @map("hike_id")
  hike       Hike?      @relation(fields: [hikeId], references: [id], onDelete: Cascade)
  url        String
  sourceType SourceType @map("source_type")
  excerpt    String     @default("")
  fetchedAt  DateTime   @default(now()) @map("fetched_at")

  @@map("sources")
}

model GuideRequest {
  id            String        @id @default(cuid())
  email         String
  questionnaire Json
  /// Nachträgliche Nutzer-Wünsche (z. B. "mehr Wandern"), Array von
  /// { presets: string[], text: string, createdAt: string }
  adjustments   Json          @default("[]")
  /// Pro-Bereich-Feintuning (mehr/weniger je Bereich), Record<areaKey, delta>
  /// z. B. { "hikes": 2, "foodBudget": 3, "sights": -1 }
  areaCounts    Json          @default("{}")
  /// Pro-Ort-Feintuning: Record<locality, Record<areaKey, delta>>
  /// z. B. { "Bellagio": { "foodBudget": 2, "sights": 1 } }
  localityCounts Json         @default("{}")
  /// Ausdrücklich gewünschte Einträge ("❤️ in den Guide"), Array von
  /// Place-/Hike-IDs. Diese erscheinen IMMER – unabhängig von Auswahl-Engine,
  /// Zielmengen und harten Filtern.
  pinnedIds     Json          @default("[]") @map("pinned_ids")
  status        RequestStatus @default(pending)
  error         String?
  /// Fortschritt der laufenden Textgenerierung (Kapitel `done` von `total`)
  progressDone  Int           @default(0) @map("progress_done")
  progressTotal Int           @default(0) @map("progress_total")
  /// Woran gerade geschrieben wird (Kapitel-Titel), für die Anzeige
  progressLabel String        @default("") @map("progress_label")
  /// Letztes Lebenszeichen des Workers – ohne das sieht ein abgestürzter
  /// Worker aus wie ein laufender.
  heartbeatAt   DateTime?     @map("heartbeat_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  guides        Guide[]

  @@map("guide_requests")
}

model Guide {
  id             String       @id @default(cuid())
  guideRequestId String       @map("guide_request_id")
  guideRequest   GuideRequest @relation(fields: [guideRequestId], references: [id], onDelete: Cascade)
  selection      Json
  content        Json
  publicToken    String       @unique @map("public_token")
  /// Read-only-Link zum Teilen mit Mitreisenden (ohne Anpassungs-Rechte)
  shareToken     String       @unique @map("share_token")
  pdfUrl         String?      @map("pdf_url")
  generatedAt    DateTime     @default(now()) @map("generated_at")
  modelUsed      String       @map("model_used")
  inputTokens    Int          @default(0) @map("input_tokens")
  outputTokens   Int          @default(0) @map("output_tokens")

  @@map("guides")
}
