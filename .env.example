# Postgres (EU-Region wählen, z. B. Supabase/Neon)
DATABASE_URL="postgresql://reisefuehrer:reisefuehrer@localhost:5432/reisefuehrer"

# Claude API
ANTHROPIC_API_KEY=""
# Modell konfigurierbar (Anforderung 4.3)
ANTHROPIC_MODEL="claude-sonnet-4-6"
# "mock" = Entwicklung/Tests OHNE API-Kosten (deterministische Platzhalter-Texte,
# kompletter Ablauf inkl. Auswahl-Engine, Queue, PDF funktioniert).
# "live" oder leer = echte Claude-API.
AI_MODE="live"

# Admin-Bereich (Basic Auth)
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me"

# Transaktionsmail (Resend). Leer lassen => Links werden nur geloggt.
RESEND_API_KEY=""
MAIL_FROM="Reiseführer <guide@example.com>"

# Öffentliche Basis-URL (für E-Mail-Links und PDF-Rendering)
APP_URL="http://localhost:3000"

# Headless Chromium für PDF-Export (Playwright)
CHROMIUM_PATH="/opt/pw-browsers/chromium"

# DSGVO: Löschfrist für personenbezogene Daten in Monaten
DATA_RETENTION_MONTHS="12"

# Nach wie vielen Minuten ohne Lebenszeichen ein laufender Generierungs-Auftrag
# als hängend gilt (Worker abgestürzt/neu gestartet) und auf "failed" gesetzt
# wird, damit er im Admin neu angestoßen werden kann.
GENERATION_STALE_MINUTES="15"

# Betreiber-Angaben für Impressum (§ 5 DDG) – Pflicht vor gewerblichem Betrieb.
# Die Startklar-Prüfung unter /admin/startklar meldet, was fehlt.
OPERATOR_NAME=""
OPERATOR_STREET=""
OPERATOR_CITY=""
OPERATOR_EMAIL=""
# Optional
OPERATOR_VAT_ID=""
OPERATOR_RESPONSIBLE=""
OPERATOR_PHONE=""
